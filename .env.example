# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated Telegram user IDs with permanent admin access, regardless
# of the `users.is_admin` flag in the database (bootstrap admins).
SUPER_ADMIN_IDS=111111111,222222222

# Closed community chat the bot manages (numeric, e.g. -1001234567890).
# Can also be configured later from the admin /settings command.
COMMUNITY_CHAT_ID=-1001234567890

TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# When false, approved Students/Psychologists get free permanent access just like
# Supervisors -- the whole payment step is skipped. Flip back to true to resume
# requiring payment (redeploy after changing).
PAYMENT_REQUIRED=true

# ---------------------------------------------------------------------------
# Telegram update delivery mode
# ---------------------------------------------------------------------------
# true  -> Telegram + Monobank both delivered via the built-in aiohttp app
#          (requires WEBHOOK_BASE_URL to be a public HTTPS address).
# false -> Telegram uses long polling; the aiohttp app still runs, but only
#          to serve the Monobank webhook route.
USE_TELEGRAM_WEBHOOK=true
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_TELEGRAM_PATH=/webhook/telegram
WEBHOOK_MONOBANK_PATH=/webhook/monobank
# Sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header; generate a
# long random string and keep it secret.
WEBHOOK_SECRET_TOKEN=change_me_random_secret
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=psychologists_club
POSTGRES_USER=psychologists_club
POSTGRES_PASSWORD=change_me_strong_password

# ---------------------------------------------------------------------------
# Redis (FSM storage)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# Monobank Acquiring
# ---------------------------------------------------------------------------
# See https://monobank.ua/api-docs/acquiring -- merchant token from
# https://web.monobank.ua/ (Мій ФОП / Acquiring section -> API token).
MONOBANK_TOKEN=change_me_merchant_token
MONOBANK_API_URL=https://api.monobank.ua
MONOBANK_MERCHANT_DOMAIN=bot.example.com
